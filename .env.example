PORT=4319
# Configure all three values to enable live AMap. The Web Service and JS API use separate keys.
AMAP_WEB_KEY=
AMAP_JS_KEY=
AMAP_JS_SECRET=
# Optional Chat Completions-compatible model for route planning decisions.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Public Terrain Tiles requires no Key. Set to terrain-tiles to enable.
ELEVATION_PROVIDER=
# Optional custom elevation endpoint accepting GCJ-02. Takes priority over ELEVATION_PROVIDER.
ELEVATION_URL=

# Optional custom OSRM bicycle instance root. Defaults to the FOSSGIS public bicycle router.
GPX_OSRM_BIKE_URL=
